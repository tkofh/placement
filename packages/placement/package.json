{
  "name": "placement",
  "version": "0.3.3",
  "description": "Layout algorithms for 2D graphics: flexbox, tracks, rects, and friends",
  "homepage": "https://github.com/tkofh/placement#readme",
  "bugs": {
    "url": "https://github.com/tkofh/placement/issues"
  },
  "license": "MIT",
  "author": "Tim Morris <timthewebguy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkofh/placement.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./adornment": {
      "types": "./dist/adornment.d.mts",
      "import": "./dist/adornment.mjs"
    },
    "./box": {
      "types": "./dist/box.d.mts",
      "import": "./dist/box.mjs"
    },
    "./dimensions": {
      "types": "./dist/dimensions.d.mts",
      "import": "./dist/dimensions.mjs"
    },
    "./edge": {
      "types": "./dist/edge.d.mts",
      "import": "./dist/edge.mjs"
    },
    "./flexbox": {
      "types": "./dist/flexbox.d.mts",
      "import": "./dist/flexbox.mjs"
    },
    "./frame": {
      "types": "./dist/frame.d.mts",
      "import": "./dist/frame.mjs"
    },
    "./hierarchy": {
      "types": "./dist/hierarchy.d.mts",
      "import": "./dist/hierarchy.mjs"
    },
    "./interval": {
      "types": "./dist/interval.d.mts",
      "import": "./dist/interval.mjs"
    },
    "./offset": {
      "types": "./dist/offset.d.mts",
      "import": "./dist/offset.mjs"
    },
    "./point": {
      "types": "./dist/point.d.mts",
      "import": "./dist/point.mjs"
    },
    "./rect": {
      "types": "./dist/rect.d.mts",
      "import": "./dist/rect.mjs"
    },
    "./track": {
      "types": "./dist/track.d.mts",
      "import": "./dist/track.mjs"
    },
    "./unstable/utils": {
      "types": "./dist/unstable/utils.d.mts",
      "import": "./dist/unstable/utils.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "curvy": "^2.0.0-alpha.17"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
