{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".output/**", ".nuxt/**"] },
    "test": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "bench": { "dependsOn": ["^build"], "cache": false },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "outputs": [".nuxt/**", ".output/**"],
      "cache": false,
      "persistent": true
    },
    "//#check": {},
    "//#check:fix": { "cache": false }
  }
}
